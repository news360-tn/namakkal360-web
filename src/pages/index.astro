---
/* "/" - the all-district home. Old Namakkal links (/?taluk=rasipuram) move to their district page (/namakkal?taluk=rasipuram). */
import Home from "../components/Home.astro";
import { districtOf, districtOfTaluk } from "../lib/geo";

const sp = new URLSearchParams(Astro.url.search);
const d = districtOf(sp.get("district") ?? undefined) ?? districtOfTaluk(sp.get("taluk") ?? "");
if (d) {
  sp.delete("district");
  const q = sp.toString();
  return Astro.redirect(`/${d.id}${q ? "?" + q : ""}`, 301);
}
---
<Home />
