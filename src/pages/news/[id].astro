---
/* One story: own address for Google and WhatsApp sharing. Tailwind classes only. */
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { langOf, tr } from "../../lib/i18n";
import { get } from "../../lib/news";
import { typeOf } from "../../lib/types";
import { talukOf, districtOf } from "../../lib/geo";
import { icon, placeName, title, when, links, PLATFORM, platformSvg, sketchImg } from "../../lib/card";
import { sourceName } from "../../lib/news";
import { safeLine, CORRECTION } from "../../lib/safe";
import { siteOrigin } from "../../lib/site";
import { paragraphs } from "../../lib/text";

const lang = langOf(Astro.url.searchParams.get("lang") ?? Astro.cookies.get("lang")?.value);
const n = await get((env as any).DB as D1Database, Astro.params.id ?? "");
if (!n) return new Response("Not found", { status: 404 });
const t = typeOf(n.type), tk = talukOf(n.taluk), d = districtOf(n.district || "namakkal")!;
const dName = lang === "ta" ? d.ta : d.en, brand = `${d.short_en} 360`;
const pn = placeName(n, lang), place = tk && pn !== tk[lang] ? `${pn}, ${tk[lang]}` : pn;
const body = (lang === "en" && n.body_en) || n.body_ta;
const origin = siteOrigin(Astro.url);
const shareUrl = new URL(`/news/${n.id}`, origin).href;
const paper = sourceName(n.source_url, lang);
const plat = links(n);
const newsDay = new Date(n.day + "T00:00:00").toLocaleDateString(lang === "ta" ? "ta-IN" : "en-IN", { day: "numeric", month: "long", year: "numeric" });
const back = lang === "en" ? `/${d.id}?lang=en` : `/${d.id}`;
const para = paragraphs(body);
const published = `${n.day}T${n.time || "00:00"}:00+05:30`;
const article = {
  "@context": "https://schema.org", "@type": "NewsArticle", headline: title(n, lang).slice(0, 110), description: body.slice(0, 200),
  image: n.images.length ? n.images : [new URL("/logo-512.png", origin).href], datePublished: published, dateModified: published,
  inLanguage: lang === "ta" || !n.body_en ? "ta" : "en", articleSection: t[lang], mainEntityOfPage: shareUrl,
  contentLocation: { "@type": "Place", name: `${place}, ${d.en} district, Tamil Nadu` },
  author: { "@type": "Organization", name: brand, url: `${origin}/${d.id}` },
  ...(n.source_url ? { isBasedOn: n.source_url } : {}),
  publisher: { "@type": "NewsMediaOrganization", name: "News 360", logo: { "@type": "ImageObject", url: new URL("/logo-512.png", origin).href } },
};
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "News 360", item: origin + "/" },
  { "@type": "ListItem", position: 2, name: dName, item: `${origin}/${d.id}` },
  ...(tk ? [{ "@type": "ListItem", position: 3, name: tk[lang], item: `${origin}/${d.id}?taluk=${tk.id}` }] : []),
  { "@type": "ListItem", position: tk ? 4 : 3, name: title(n, lang).slice(0, 80) }] };
---
<Base lang={lang} title={title(n, lang)} description={body.slice(0, 160)} image={n.images[0]} path={`/news/${n.id}`} type="article" noindex={lang === "en" && !n.body_en} jsonld={[article, crumbs]} district={d.id}>
  <article class="-mx-4 mb-5 overflow-hidden border-line bg-surface sm:mx-auto sm:my-6 sm:max-w-[760px] sm:rounded-xl sm:border">
    <figure class="relative aspect-video overflow-hidden border-b border-line bg-white">
      {n.images[0]
        ? <Fragment set:html={sketchImg(n.images[0], title(n, lang), "size-full", false)} />
        : <span class:list={["grid size-full place-items-center", t.text, t.soft]} set:html={icon(n.type, "size-14")} />}
      {n.images[0] && <figcaption class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-linear-to-t from-black/55 to-transparent px-3 pt-6 pb-2 text-[11.5px] font-medium text-white">
        <span>✏️ {tr(lang, "sketchNote")}</span>
        <a href={n.images[0]} target="_blank" rel="noopener" class="shrink-0 rounded-md bg-white/90 px-2 py-1 font-semibold text-slate-900 hover:bg-white">📷 {tr(lang, "photo")}</a>
      </figcaption>}
    </figure>
    <div class="px-4 pt-4 pb-6 sm:p-7">
      <a href={back} class="text-[13px] font-semibold text-accent hover:underline">← {dName} {tr(lang, "back")}</a>
      <p class="mt-3 flex flex-wrap items-center gap-1.5 text-[13px] font-semibold text-mute">
        <span class:list={["size-2 rounded-full", t.bg]}></span><b class={t.text}>{t[lang]}</b> · {pn} · {lang === "ta" ? d.short_ta : d.short_en} · {when(n, lang)}
      </p>
      <h1 class="mt-2 font-head text-[24px] leading-snug font-bold text-balance sm:text-[30px]">{title(n, lang)}</h1>
      {paper && <a href={n.source_url} target="_blank" rel="noopener nofollow" class="mt-2 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-mute hover:text-accent">📰 {tr(lang, "source")}: <span class="text-ink underline decoration-line underline-offset-2">{paper}</span> ↗</a>}
      {lang === "en" && !n.body_en && <p class="mt-2 text-sm font-medium text-mute">{tr(lang, "tamilOnly")}</p>}
      <div class="mt-4 space-y-4 text-[17px] leading-[1.85] sm:text-[17.5px]">
        {para.lead && <p class="border-l-4 border-accent pl-3 text-[18px] leading-[1.7] font-semibold sm:text-[19px]">{para.lead}</p>}
        {para.rest.map((x) => <p>{x}</p>)}
      </div>

      {n.images.length > 1 && (
        <div class="mt-5 grid grid-cols-2 gap-2">
          {n.images.slice(1).map((src) => <a href={src} target="_blank" rel="noopener" class="block overflow-hidden rounded-lg border border-line bg-white"><Fragment set:html={sketchImg(src, "", "aspect-video w-full")} /></a>)}
        </div>
      )}

      <h2 class="mt-7 font-head text-base font-bold">📋 {tr(lang, "details")}</h2>
      <dl class="mt-2 divide-y divide-line rounded-lg border border-line bg-raise px-4 text-[14.5px]">
        <div class="flex justify-between gap-3 py-2.5"><dt class="font-medium text-mute">{tr(lang, "place")}</dt><dd class="text-right font-semibold">{place}</dd></div>
        {n.facts.map((x) => x.label
          ? <div class="flex justify-between gap-3 py-2.5"><dt class="font-medium text-mute">{x.label}</dt><dd class="text-right font-semibold">{x.value}</dd></div>
          : <div class="flex gap-2 py-2.5"><dt class="text-accent">•</dt><dd class="font-medium leading-relaxed">{x.value}</dd></div>)}
      </dl>

      {plat.length > 0 && (<Fragment>
        <h2 class="mt-7 font-head text-base font-bold">▶ {tr(lang, "watchOn")}</h2>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          {plat.map(([k, u]) => <a href={u} target="_blank" rel="noopener"
            class:list={["flex h-12 items-center justify-center gap-2 rounded-lg border border-line bg-surface font-semibold transition hover:border-current active:scale-[.98]", PLATFORM[k].cls]}>
            <Fragment set:html={platformSvg(k, "size-5")} /><span class="text-ink">{PLATFORM[k].name}</span></a>)}
        </div>
      </Fragment>)}

      <a href={`https://wa.me/?text=${encodeURIComponent(`${title(n, lang)} ${shareUrl}`)}`} target="_blank" rel="noopener"
        class="mt-3 flex h-12 items-center justify-center rounded-lg bg-wa font-semibold text-white transition hover:brightness-110 active:scale-[.98] dark:text-slate-950">{tr(lang, "share")}</a>

      <!-- owner 26 Nov: the same safe note as the page's first comment on Instagram / Facebook / YouTube: source, date, the line
           for this kind of news and how to ask for a correction -->
      <aside aria-label={tr(lang, "aboutNews")} class="mt-7 rounded-lg border border-line border-l-4 border-l-accent bg-raise p-4 text-[14px] leading-relaxed">
        <h2 class="font-head text-[15px] font-bold">{tr(lang, "aboutNews")}</h2>
        <dl class="mt-2 grid gap-1.5">
          <div class="flex flex-wrap gap-x-2"><dt class="font-semibold">📰 {tr(lang, "source")}:</dt>
            <dd>{n.source_url
              ? <a href={n.source_url} target="_blank" rel="noopener nofollow" class="font-semibold text-accent underline underline-offset-2 break-all">{paper} - {tr(lang, "readOriginal")} ↗</a>
              : <span class="text-mute">{tr(lang, "noSource")}</span>}</dd></div>
          <div class="flex flex-wrap gap-x-2"><dt class="font-semibold">📅 {tr(lang, "newsDate")}:</dt><dd>{newsDay}</dd></div>
        </dl>
        <p class="mt-2.5 text-ink/90">{safeLine(n.safe_kind, n.type, lang)}</p>
        <p class="mt-2 text-mute">{CORRECTION[lang]}</p>
      </aside>
    </div>
  </article>
</Base>
