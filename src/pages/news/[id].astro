---
/* One story: own address for Google and WhatsApp sharing. Tailwind classes only. */
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { langOf, tr } from "../../lib/i18n";
import { get } from "../../lib/news";
import { typeOf } from "../../lib/types";
import { talukOf } from "../../lib/geo";
import { icon, placeName, title, when } from "../../lib/card";

const lang = langOf(Astro.url.searchParams.get("lang") ?? Astro.cookies.get("lang")?.value);
const n = await get((env as any).DB as D1Database, Astro.params.id ?? "");
if (!n) return new Response("Not found", { status: 404 });
const t = typeOf(n.type), tk = talukOf(n.taluk);
const pn = placeName(n, lang), place = tk && pn !== tk[lang] ? `${pn}, ${tk[lang]}` : pn;
const body = (lang === "en" && n.body_en) || n.body_ta;
const shareUrl = new URL(`/news/${n.id}`, Astro.url).href;
const back = lang === "en" ? "/?lang=en" : "/";
---
<Base lang={lang} title={title(n, lang)} description={body.slice(0, 160)} image={n.images[0]}>
  <article class="mx-auto my-5 max-w-[720px] overflow-hidden rounded-[22px] border border-black/5 bg-white/80 shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-slate-900/70">
    <div class="aspect-video overflow-hidden">
      {n.images[0]
        ? <img src={n.images[0]} alt="" class="size-full object-cover" />
        : <span class:list={["grid size-full place-items-center", t.text, t.soft]} set:html={icon(n.type, "size-14")} />}
    </div>
    <div class="p-5 sm:p-7">
      <a href={back} class="text-[13px] font-bold text-brand-fresh">← {tr(lang, "back")}</a>
      <p class="mt-3 flex flex-wrap items-center gap-1.5 text-[13px] font-semibold text-slate-500 dark:text-slate-400">
        <b class={t.text}>{t[lang]}</b> · {pn} · {when(n, lang)}
      </p>
      <h1 class="mt-2 text-2xl leading-snug font-extrabold text-balance sm:text-[28px]">{title(n, lang)}</h1>
      {lang === "en" && !n.body_en && <p class="mt-2 text-sm font-semibold text-slate-500">{tr(lang, "tamilOnly")}</p>}
      <p class="mt-4 text-[17px] leading-[1.8] whitespace-pre-line">{body}</p>

      {n.images.length > 1 && (
        <div class="mt-5 grid grid-cols-2 gap-2">
          {n.images.slice(1).map((src) => <img src={src} alt="" loading="lazy" class="aspect-video w-full rounded-xl object-cover" />)}
        </div>
      )}

      <h2 class="mt-6 text-base font-extrabold">📋 {tr(lang, "details")}</h2>
      <dl class="mt-2 divide-y divide-black/10 rounded-2xl bg-black/[.04] px-4 text-[14.5px] dark:divide-white/10 dark:bg-white/5">
        <div class="flex justify-between gap-3 py-2.5"><dt class="font-semibold text-slate-500 dark:text-slate-400">{tr(lang, "place")}</dt><dd class="text-right font-bold">{place}</dd></div>
        {n.facts.map((x) => <div class="flex justify-between gap-3 py-2.5"><dt class="font-semibold text-slate-500 dark:text-slate-400">{x.label}</dt><dd class="text-right font-bold">{x.value}</dd></div>)}
      </dl>

      <div class="mt-5 flex gap-2.5">
        <a href={`https://wa.me/?text=${encodeURIComponent(`${title(n, lang)} ${shareUrl}`)}`} target="_blank" rel="noopener"
          class="grid h-12 flex-1 place-items-center rounded-xl bg-[#1faf38] font-extrabold text-white transition active:scale-95">{tr(lang, "share")}</a>
        {n.reel_url && <a href={n.reel_url} target="_blank" rel="noopener"
          class="grid h-12 flex-1 place-items-center rounded-xl bg-black/5 font-extrabold transition active:scale-95 dark:bg-white/10">▶ {tr(lang, "reel")}</a>}
      </div>
      {n.source_url && <p class="mt-4 text-xs text-slate-500">{tr(lang, "source")}: <a href={n.source_url} target="_blank" rel="noopener nofollow" class="underline">{new URL(n.source_url).hostname}</a></p>}
    </div>
  </article>
</Base>
