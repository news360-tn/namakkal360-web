---
/* News list for the whole site ("/": all 7 districts, with the district cards) or one district ("/coimbatore"):
   area banner -> area / town chips -> type + date -> pinned power cuts -> news, numbered pages.
   Every filter is a plain link, so any view can be shared and works without JavaScript. */
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { langOf, tr } from "../lib/i18n";
import { DISTRICTS, districtOf, talukOf, placeOf } from "../lib/geo";
import { TYPES, typeOf } from "../lib/types";
import { sanitize, list, powerAlerts, districtStats, PAGE, type Filter } from "../lib/news";
import { cardHtml, leadHtml, alertHtml, when, title as titleOf } from "../lib/card";
import { siteOrigin } from "../lib/site";

interface Props { district?: string }
const url = Astro.url, sp = url.searchParams;
const lang = langOf(sp.get("lang") ?? Astro.cookies.get("lang")?.value);
const f = sanitize({ ...Object.fromEntries(sp), district: Astro.props.district });
const d = districtOf(f.district);
const hub = !d;      // the all-district home page
const db = (env as any).DB as D1Database;
// numbered pages, 15 news each (?page=2); power-cut notices are pinned on page 1
const pg = Math.max(1, Math.min(500, parseInt(sp.get("page") ?? "1", 10) || 1));
const [{ items, total }, alerts, stats] = await Promise.all([
  list(db, { ...f, page: pg - 1 }),
  pg > 1 || (f.type && f.type !== "power") ? Promise.resolve([]) : powerAlerts(db, f),
  hub && pg === 1 ? districtStats(db) : Promise.resolve({} as Awaited<ReturnType<typeof districtStats>>)]);
const pages = Math.max(1, Math.ceil(total / PAGE));
const rest = items.filter((n) => !alerts.some((a) => a.id === n.id));

const tk = f.taluk ? talukOf(f.taluk) : undefined;
const banner = { img: tk?.banner ?? (tk ? undefined : d?.banner), credit: tk?.banner ? tk.credit : d?.credit };
const dName = d ? (lang === "ta" ? d.ta : d.en) : "";
const taluks = d?.taluks ?? [];
const home = d ? `/${d.id}` : "/";
const heading = [f.place && tk ? placeOf(tk.id, f.place)?.[lang] : tk?.[lang], f.type ? typeOf(f.type)[lang] : ""].filter(Boolean).join(" · ") || tr(lang, "latest");

/** link that keeps the other filters (and the language) */
function link(change: Partial<Record<keyof Filter | "pg", string | undefined>>) {
  const p = new URLSearchParams();
  const next: Record<string, string | undefined> = { taluk: f.taluk, place: f.place, type: f.type, date: f.date, q: f.q, ...change };
  const toPage = next.pg; delete next.pg;
  if (toPage && toPage !== "1") next.page = toPage;
  for (const [k, v] of Object.entries(next)) if (v) p.set(k, v);
  if (lang === "en") p.set("lang", "en");
  const s = p.toString();
  return s ? `${home}?${s}` : home;
}
const chip = "inline-flex h-9 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-3 text-[13.5px] font-semibold transition active:scale-95";
const off = "border-line bg-surface text-ink hover:border-mute";
const on = "border-accent bg-accent text-accent-ink";
const row = "flex flex-wrap gap-1.5 py-0.5";      // every taluk and type always visible (wraps to the next line, no hidden sideways scroll)
const pill = "h-10 min-w-44 appearance-none rounded-lg border border-line bg-surface pr-10 pl-3.5 text-[14px] font-semibold text-ink outline-none focus:border-accent";
const sel = "h-11 w-full appearance-none rounded-lg border border-line bg-surface pr-10 pl-3 text-[14.5px] font-semibold text-ink outline-none focus:border-accent";
const caret = '<svg aria-hidden="true" class="pointer-events-none absolute top-1/2 right-3.5 size-4 -translate-y-1/2 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
const pageBtn = "grid h-10 min-w-10 place-items-center rounded-lg border px-3 text-sm font-semibold transition active:scale-95";
const dateOpts: [string, string][] = [["", tr(lang, "anyDay")], ["today", tr(lang, "today")], ["yesterday", tr(lang, "yesterday")], ["week", tr(lang, "week")]];
/** page numbers: 1 … 4 5 6 … 20 */
const nums: (number | "…")[] = [];
for (let i = 1; i <= pages; i++) {
  if (i === 1 || i === pages || Math.abs(i - pg) <= 1) nums.push(i);
  else if (nums[nums.length - 1] !== "…") nums.push("…");
}
const base = f.taluk ? `${home}?taluk=${f.taluk}` : home;
const canonicalPath = pg > 1 ? `${base}${base.includes("?") ? "&" : "?"}page=${pg}` : base;
---
<Base lang={lang} path={canonicalPath} noindex={!!(f.place || f.type || f.date || f.q)} district={d?.id}
  title={tk ? `${tk[lang]} ${tr(lang, "stories")}` : d ? `${dName} ${tr(lang, "districtNews")}` : undefined}
  description={tk ? `${tk[lang]}: ${tk.places.map((p) => p[lang]).join(", ")} - ${dName} ${tr(lang, "aboutOne")}`
    : d ? `${dName} ${tr(lang, "aboutOne")} ${taluks.map((t) => t[lang]).join(", ")}.` : undefined}
  jsonld={[{ "@context": "https://schema.org", "@type": "WebSite", name: "News 360", url: siteOrigin(Astro.url) + "/", inLanguage: ["ta", "en"] }]}>
  {/* all-district home: one card per district (its own logo), with today's count and its newest headline */}
  {hub ? (<Fragment>
    <section class="my-5 rounded-xl border border-line bg-surface p-6 max-sm:my-3 max-sm:p-4">
      <p class="text-[12.5px] font-semibold tracking-wide text-accent uppercase">News 360</p>
      <h1 class="mt-1 font-head text-[clamp(22px,4vw,34px)] leading-tight font-bold text-balance">{tr(lang, "hubTitle")}</h1>
      <p class="mt-1.5 max-w-[680px] text-[14.5px] text-mute max-sm:text-[13.5px]">{tr(lang, "hubSub")}</p>
      <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-raise px-3 py-2 text-[13px] font-medium text-mute">📰 {tr(lang, "sourceNote")}</p>
    </section>
    <nav aria-label="Districts" class="grid grid-cols-4 gap-3 max-lg:grid-cols-3 max-sm:grid-cols-2 max-sm:gap-2.5">
      {DISTRICTS.map((x) => { const st = stats[x.id]; return (
        <a href={lang === "en" ? `/${x.id}?lang=en` : `/${x.id}`} data-district={x.id}
          class="group flex min-h-[132px] flex-col gap-2 rounded-xl border border-line bg-surface p-4 transition hover:-translate-y-0.5 hover:border-accent active:scale-[.98] max-sm:min-h-[120px] max-sm:p-3">
          <span class="flex items-center gap-2.5">
            <img src={`/brand/${x.id}.webp`} alt="" width="40" height="40" loading="lazy" class="size-10 shrink-0 rounded-full border border-line max-sm:size-9" />
            <span class="min-w-0 leading-tight">
              <b class="block font-head text-[17px] leading-tight font-bold max-sm:text-[15.5px]">{lang === "ta" ? x.short_ta : x.short_en} <span class="text-accent">360</span></b>
              <span class="block text-[12px] font-medium text-mute">{x.taluks.length} {tr(lang, "taluks")}</span>
            </span>
          </span>
          {st?.today ? <span class="w-fit rounded-full bg-accent-soft px-2 py-0.5 text-[12px] font-semibold text-accent">{tr(lang, "today")} {st.today}</span> : null}
          {st?.latest && <span class="mt-auto line-clamp-2 text-[13px] leading-snug font-medium text-ink/85 group-hover:text-ink">{titleOf(st.latest, lang)}</span>}
        </a>); })}
      <a href="#latest" class="flex min-h-[132px] flex-col justify-center gap-1 rounded-xl border border-dashed border-line bg-raise p-4 transition hover:border-accent active:scale-[.98] max-sm:min-h-[120px]">
        <b class="font-head text-[17px] font-bold">{tr(lang, "latest")} ↓</b>
        <span class="text-[12.5px] font-medium text-mute">{tr(lang, "allDistricts")}</span>
      </a>
    </nav>
  </Fragment>) : (
  <section class="my-5 grid overflow-hidden rounded-xl border border-line bg-surface sm:grid-cols-[1.1fr_1fr] max-sm:my-3">
    <div class="flex flex-col gap-2 p-6 max-sm:order-2 max-sm:p-4">
      <a href={lang === "en" ? "/?lang=en" : "/"} class="inline-flex min-h-8 items-center text-[13px] font-semibold text-accent hover:underline">← {tr(lang, "allDistricts")}</a>
      <div class="flex items-center gap-3">
        <img src={`/brand/${d!.id}.webp`} alt="" width="52" height="52" class="size-13 shrink-0 rounded-full border border-line max-sm:size-11" />
        <h1 class="font-head text-[clamp(24px,3.6vw,34px)] leading-tight font-bold">{tk ? tk[lang] : `${dName} ${tr(lang, "districtWord")}`}</h1>
      </div>
      <p class="text-[14px] text-mute max-sm:line-clamp-2">{tk ? tk.places.map((p) => p[lang]).join(" · ") : `${taluks.length} ${tr(lang, "taluks")} · ${tr(lang, "everyTown")}`}</p>
      {tk && <button id="star" type="button" data-taluk={tk.id} data-on={tr(lang, "mine")} data-off={tr(lang, "setMine")}
        class="mt-1 flex h-9 w-fit items-center rounded-lg border border-line bg-raise px-3 text-[13px] font-semibold transition active:scale-95 aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent">☆ {tr(lang, "setMine")}</button>}
    </div>
    <figure class:list={["relative min-h-[170px] bg-white max-sm:order-1 max-sm:min-h-[130px] max-sm:border-b max-sm:border-line sm:border-l sm:border-line", !banner.img && "max-sm:hidden"]}>
      {banner.img
        ? <img src={banner.img} alt="" class="absolute inset-0 size-full bg-white object-cover object-[30%_40%] [filter:url(#sketch)]" />
        : <span aria-hidden="true" class="absolute inset-0 grid place-items-center bg-raise"><img src={`/brand/${d!.id}.webp`} alt="" width="96" height="96" class="size-24 rounded-full opacity-80" /></span>}
      {banner.credit && banner.img && <figcaption class="absolute right-2 bottom-1.5 rounded bg-white/85 px-1.5 text-[10px] text-slate-600">📷 {banner.credit}</figcaption>}
    </figure>
  </section>
  )}

  {d && <nav class:list={[row, "max-sm:hidden"]} aria-label="Area">
    <a href={link({ taluk: undefined, place: undefined })} class:list={[chip, !f.taluk ? on : off]}>{tr(lang, "all")}</a>
    {taluks.map((t) => <a href={link({ taluk: t.id, place: undefined })} data-taluk={t.id} class:list={[chip, f.taluk === t.id ? on : off]}>{t[lang]}</a>)}
  </nav>}
  {tk && (
    <nav class:list={[row, "mt-2 max-sm:hidden"]} aria-label="Town">
      <a href={link({ place: undefined })} class:list={[chip, "h-8 text-[13.5px]", !f.place ? "border-ink bg-ink text-bg" : "border-transparent bg-raise text-ink hover:border-line"]}>{tr(lang, "allOf")} {tk[lang]}</a>
      {tk.places.map((p) => <a href={link({ place: p.id })} class:list={[chip, "h-8 text-[13.5px]", f.place === p.id ? "border-ink bg-ink text-bg" : "border-transparent bg-raise text-ink hover:border-line"]}>{p[lang]}</a>)}
    </nav>
  )}

  <!-- phones: compact dropdowns instead of many rows of buttons -->
  <form action={home} method="get" class:list={["grid grid-cols-2 gap-2 sm:hidden", hub && "mt-4"]}>
    {lang === "en" && <input type="hidden" name="lang" value="en" />}
    {f.q && <input type="hidden" name="q" value={f.q} />}
    {d && <label class:list={["flex flex-col gap-1 text-[12px] font-semibold text-mute", !tk && "col-span-2"]}>{tr(lang, "area")}
      <span class="relative block w-full sm:w-auto"><select name="taluk" onchange="this.form.place && (this.form.place.value=''); this.form.submit()" class={sel}>
        <option value="">{tr(lang, "all")}</option>
        {taluks.map((t) => <option value={t.id} selected={f.taluk === t.id}>{t[lang]}</option>)}
      </select><Fragment set:html={caret} /></span></label>}
    {tk ? (
      <label class="flex flex-col gap-1 text-[12px] font-semibold text-mute">{tr(lang, "town")}
        <span class="relative block w-full sm:w-auto"><select name="place" onchange="this.form.submit()" class={sel}>
          <option value="">{tr(lang, "allOf")} {tk[lang]}</option>
          {tk.places.map((p) => <option value={p.id} selected={f.place === p.id}>{p[lang]}</option>)}
        </select><Fragment set:html={caret} /></span></label>
    ) : null}
    <label class="flex flex-col gap-1 text-[12px] font-semibold text-mute">{tr(lang, "kind")}
      <span class="relative block w-full sm:w-auto"><select name="type" onchange="this.form.submit()" class={sel}>
        <option value="">{tr(lang, "all")}</option>
        {TYPES.map((t) => <option value={t.id} selected={f.type === t.id}>{t[lang]}</option>)}
      </select><Fragment set:html={caret} /></span></label>
    <label class="flex flex-col gap-1 text-[12px] font-semibold text-mute">{tr(lang, "day")}
      <span class="relative block w-full sm:w-auto"><select name="date" onchange="this.form.submit()" class={sel}>
        {dateOpts.map(([v, l]) => <option value={v} selected={(f.date ?? "") === v}>{l}</option>)}
      </select><Fragment set:html={caret} /></span></label>
  </form>

  <!-- desktop: type + date as two dropdowns (only the taluks are buttons) -->
  <form action={home} method="get" class="mt-3.5 mb-1.5 flex items-center gap-2.5 max-sm:hidden">
    {Object.entries({ taluk: f.taluk, place: f.place, q: f.q, lang: lang === "en" ? "en" : undefined }).filter(([, v]) => v).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
    <label class="flex items-center gap-2 text-[13px] font-semibold text-mute">{tr(lang, "kind")}
      <span class="relative block w-full sm:w-auto"><select name="type" onchange="this.form.submit()" class={pill}>
        <option value="">{tr(lang, "all")}</option>
        {TYPES.map((t) => <option value={t.id} selected={f.type === t.id}>{t[lang]}</option>)}
      </select><Fragment set:html={caret} /></span></label>
    <label class="flex items-center gap-2 text-[13px] font-semibold text-mute">{tr(lang, "day")}
      <span class="relative block w-full sm:w-auto"><select name="date" onchange="this.form.submit()" class={pill}>
        {dateOpts.map(([v, l]) => <option value={v} selected={(f.date ?? "") === v}>{l}</option>)}
        {f.date && /^\d/.test(f.date) && <option value={f.date} selected>{f.date}</option>}
      </select><Fragment set:html={caret} /></span></label>
  </form>

  <div id="latest" class="mt-6 mb-3 flex scroll-mt-32 items-end justify-between gap-3">
    <div>
      <h2 class="font-head text-xl font-bold">{heading}</h2>
      <span class="block text-[13px] font-medium text-mute">{total} {tr(lang, "stories")}{pages > 1 && ` · ${tr(lang, "page")} ${pg} / ${pages}`}</span>
    </div>
    {(f.taluk || f.type || f.date || f.q) && <a href={lang === "en" ? `${home}?lang=en` : home} class="text-[13px] font-semibold text-accent hover:underline">{tr(lang, "showAll")}</a>}
  </div>

  <Fragment set:html={alerts.map((n) => alertHtml(n, lang, hub)).join("")} />

  <section id="grid" class="grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1 max-sm:gap-2.5">
    <Fragment set:html={rest.map((n, i) => (i === 0 && pg === 1 && !f.q ? leadHtml(n, lang, hub) : cardHtml(n, lang, hub))).join("")} />
  </section>
  {!items.length && !alerts.length && <p class="rounded-xl border border-dashed border-line bg-surface py-10 text-center text-mute">{tr(lang, "empty")}</p>}
  {pages > 1 && (
    <nav aria-label="Pages" class="mt-8 flex flex-wrap items-center justify-center gap-1.5">
      {pg > 1 && <a href={link({ pg: String(pg - 1) })} rel="prev" class:list={[pageBtn, "border-line bg-surface hover:border-mute"]}>‹ {tr(lang, "prev")}</a>}
      {nums.map((x) => x === "…"
        ? <span class="px-1 text-mute">…</span>
        : <a href={link({ pg: String(x) })} aria-current={x === pg ? "page" : undefined}
            class:list={[pageBtn, x === pg ? "border-accent bg-accent text-accent-ink" : "border-line bg-surface hover:border-mute"]}>{x}</a>)}
      {pg < pages && <a href={link({ pg: String(pg + 1) })} rel="next" class:list={[pageBtn, "border-line bg-surface hover:border-mute"]}>{tr(lang, "next")} ›</a>}
    </nav>
  )}

  <button id="toTop" type="button" aria-label="Back to top"
    class="pointer-events-none fixed right-4 bottom-5 z-40 grid size-[46px] translate-y-2.5 place-items-center rounded-full bg-accent text-accent-ink opacity-0 shadow-lg transition data-[on]:pointer-events-auto data-[on]:translate-y-0 data-[on]:opacity-100">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
  </button>
</Base>

<script>
  // back-to-top, "my area" (kept only in this browser)
  const top = document.getElementById("toTop")!;
  addEventListener("scroll", () => top.toggleAttribute("data-on", scrollY > 600), { passive: true });
  top.onclick = () => scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });

  const star = document.getElementById("star");
  const mine = (() => { try { return localStorage.getItem("n360area") || ""; } catch { return ""; } })();
  if (mine) document.querySelector(`nav [data-taluk="${mine}"]`)?.prepend("⭐ ");
  if (star) {
    const paint = (on: boolean) => { star.setAttribute("aria-pressed", String(on)); star.textContent = (on ? "⭐ " : "☆ ") + (on ? star.dataset.on : star.dataset.off); };
    paint(mine === star.dataset.taluk);
    star.onclick = () => {
      const on = star.getAttribute("aria-pressed") !== "true";
      try { on ? localStorage.setItem("n360area", star.dataset.taluk!) : localStorage.removeItem("n360area"); } catch {}
      paint(on);
    };
  }
  // returning reader: open on their own area (only on the plain home page)
  if (mine && location.pathname === "/" && location.search.replace(/[?&]lang=\w+/, "") === "" && !sessionStorage.getItem("n360seen")) {
    sessionStorage.setItem("n360seen", "1");
    location.replace(`/?taluk=${mine}${location.search.includes("lang=en") ? "&lang=en" : ""}`);      // the server sends it on to the district page
  }
</script>
