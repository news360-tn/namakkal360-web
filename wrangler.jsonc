{
  // Cloudflare Worker that serves the website, the news API and the D1 news database
  "name": "namakkal360",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    // online database in the owner's Cloudflare account
    { "binding": "DB", "database_name": "namakkal360", "database_id": "3f2da005-d435-455d-9bfc-43983ff525a4" }
  ],
  "observability": { "enabled": true }
}
